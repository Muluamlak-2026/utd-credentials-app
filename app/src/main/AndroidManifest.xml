<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Round 32: app-lock's fingerprint option (BiometricPrompt). Normal
         protection level, granted automatically, no runtime prompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Round 48: Export buttons hand off to DownloadManager, which on
         Android 9 (API 28) and below needs this permission to write into
         the public Downloads folder (granted automatically, since it's
         capped to those old versions); Android 10+ (API 29+, this app's
         actual likely floor in practice) doesn't need it for that at all. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- Round 48c: lets MainActivity prompt the system's own "allow this
         app to ignore battery optimizations" dialog, which addresses both
         the app-lock and notification-delivery reliability issues on
         phones with aggressive background app killing. A normal
         permission, granted automatically at install; it's the ACTUAL
         exemption that still requires the user to tap Allow on the dialog
         shown at runtime. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Round 57: the offline data feature's sync-on-reconnect runs as a
         genuine foreground service (a persistent notification while it's
         actively pushing/pulling), per the admin's explicit request for
         reliable background sync; these two permissions are both required
         for that: FOREGROUND_SERVICE is the general grant, and
         FOREGROUND_SERVICE_DATA_SYNC is the specific typed grant Android 14+
         (API 34) requires for a "sync data with a server" foreground service
         (untyped foreground services are rejected outright on API 34+).
         Both are normal permissions, granted automatically at install;
         nothing for the admin to approve beyond installing the update. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:name=".UtdCredentialsApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.UtdCredentials"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.UtdCredentials"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- CrashHandler's recovery screen: launched from a global
             uncaught exception handler, so it must be its own task and
             never require the app to already be in a working state. -->
        <activity
            android:name=".CrashReportActivity"
            android:exported="false"
            android:theme="@style/Theme.UtdCredentials"
            android:launchMode="singleTask" />

        <service
            android:name=".push.UtdFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Round 48p: the final, coordinate-free fallback for the Sign
             In/Continue click problem, see
             UtdClickAccessibilityService's own doc comment. Must be
             exported with BIND_ACCESSIBILITY_SERVICE (the only permission
             the OS accepts for this) so the system Settings/Accessibility
             screen can bind to it; utd_accessibility_service_config.xml's
             packageNames restricts what it can ever see to this app alone,
             and it only runs once the admin manually enables it once in
             Settings, never silently. -->
        <service
            android:name=".accessibility.UtdClickAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/utd_accessibility_service_config" />
        </service>

        <!-- Round 57: shows a persistent notification while an offline
             sync (pull + push of pending users/credentials changes) is
             actively running; started the moment connectivity returns
             (see data/offline/ConnectivitySyncTrigger.kt) and by the
             periodic WorkManager backstop (push/SyncWorker.kt), and stops
             itself the instant that sync run finishes. dataSync is the
             Android 14+ (API 34) required foreground-service TYPE for
             exactly this kind of work (syncing local data with a server). -->
        <service
            android:name=".push.SyncForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
